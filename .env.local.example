# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Brevo (para emails de confirmación de reservas)
# Obtén tu API Key en: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key

# Email remitente para Brevo
# Brevo NO requiere dominio verificado para testing, puedes usar cualquier email
BREVO_FROM_EMAIL=reservas@orobarberiaarte.com

# Email del peluquero para notificaciones
PELUQUERO_EMAIL=your-email@example.com
