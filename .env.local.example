# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend (para emails de confirmación de reservas)
RESEND_API_KEY=your-resend-api-key

# Email remitente para Resend (IMPORTANTE: debe ser de un dominio verificado en Resend)
# Si no se configura, se usará onboarding@resend.dev (solo envía al propietario de la cuenta)
# Para enviar a clientes externos, verifica tu dominio en Resend y usa: reservas@tudominio.com
RESEND_FROM_EMAIL=reservas@tudominio.com

# Email del peluquero para notificaciones
PELUQUERO_EMAIL=your-email@example.com
