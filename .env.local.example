# Copia este archivo como .env.local (local) y añade las mismas variables en
# Vercel → Settings → Environment Variables (producción).
# ⚠️ Nunca pongas aquí claves reales: este archivo se sube a GitHub.

# Supabase (obligatorio)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Brevo (emails de confirmación). Clave en https://app.brevo.com/settings/keys/api
BREVO_API_KEY=tu-brevo-api-key
BREVO_FROM_EMAIL=email-verificado-en-brevo@ejemplo.com
PELUQUERO_EMAIL=email-de-fran@ejemplo.com

# Panel admin: el mismo email que pusiste en supabase-security.sql
ADMIN_EMAIL=email-admin@ejemplo.com

# Google Calendar (opcional, ver GOOGLE-CALENDAR.md)
GOOGLE_SERVICE_ACCOUNT_EMAIL=reservas-web@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=gmail-de-fran@gmail.com
