# 🔐 Variables de entorno - PLANTILLA
# Copia este archivo como .env.local y rellena con tus credenciales reales

# Supabase Configuration
# Obtén estos valores en: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env.local
# 2. Rellena con tus credenciales reales de Supabase
# 3. NO subas .env.local a Git (ya está en .gitignore)
